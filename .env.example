# ==============================================================================
# Supabase Database Configuration (PostgreSQL)
# ==============================================================================
# Obtain these credentials from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / service_role)
# If left blank, the application automatically runs in Local SQLite Mode.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
